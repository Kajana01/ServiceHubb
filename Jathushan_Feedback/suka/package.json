{
  "name": "servicehub",
  "version": "1.0.0",
  "description": "A comprehensive service booking platform with user management, inventory tracking, and feedback system",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "seed": "cd server/scripts && node seedAllData.js",
    "start": "cd server && npm start"
  },
  "keywords": [
    "service-booking",
    "react",
    "nodejs",
    "express",
    "mongodb",
    "booking-platform",
    "inventory-management",
    "feedback-system"
  ],
  "author": "ServiceHub Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^7.6.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}